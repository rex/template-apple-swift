# fastlane/SigningFastfile — App Store Connect auth + code-signing material.
#
# Imported by fastlane/Fastfile. Owns: reading our API-key env vars, turning a
# base64 .p8 into a real file for xcodebuild, the -allowProvisioningUpdates
# xcargs string, the ExportOptions.plist consistency assertion, and the
# `certs` (match) lane.
#
# Default signing is automatic/cloud: Xcode 13+ cloud-managed DISTRIBUTION
# certificates keep the private key with Apple, so an ephemeral runner can
# sign App Store builds with nothing in its keychain (R1 V20). Development and
# Developer ID certificates are NOT cloud-managed — that is what `match` is
# for, and why the notarised-Mac path effectively wants it.

require "base64"
require "shellwords"
require "tempfile"

# Tempfiles holding a materialised .p8 must outlive the lane that made them:
# Tempfile's finaliser unlinks the file when the object is collected, and
# xcodebuild reads that path minutes later.
ASC_KEY_TEMPFILES = []

private_lane :load_asc_api_key do
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s
  base64 = ENV["APP_STORE_CONNECT_API_KEY"].to_s
  p8     = ENV["APP_STORE_CONNECT_API_KEY_P8_PATH"].to_s

  if key_id.empty?
    UI.important("APP_STORE_CONNECT_API_KEY_ID unset — running unauthenticated.")
    UI.important("Only offline lanes will work. See .env.example / docs/asc-setup.md.")
    next
  end
  if base64.empty? == p8.empty?
    UI.user_error!("Set exactly ONE of APP_STORE_CONNECT_API_KEY (base64 .p8) " \
                   "or APP_STORE_CONNECT_API_KEY_P8_PATH (file path).")
  end

  # Our env names deliberately differ from fastlane's own
  # APP_STORE_CONNECT_API_KEY_KEY_ID / _ISSUER_ID / _KEY, so they are read here
  # and passed as parameters (contracts §8, R1 V22).
  params = {
    key_id: key_id,
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER"),
    duration: 1200, # seconds; fastlane's verify_block caps this at 1200
    in_house: false,
  }
  if base64.empty?
    params[:key_filepath] = File.expand_path(p8)
  else
    params[:key_content] = base64
    params[:is_key_content_base64] = true
  end
  app_store_connect_api_key(params)
end

private_lane :api_key do
  lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
end

# Absolute path to a real .p8 on disk. xcodebuild's -authenticationKeyPath
# cannot take base64, so the CI-friendly env form is materialised here.
private_lane :asc_key_file do
  path = ENV["APP_STORE_CONNECT_API_KEY_P8_PATH"].to_s
  if path.empty?
    b64 = ENV["APP_STORE_CONNECT_API_KEY"].to_s
    UI.user_error!("No App Store Connect key in the environment.") if b64.empty?
    file = Tempfile.new(["AuthKey", ".p8"])
    file.write(Base64.decode64(b64))
    file.close
    File.chmod(0o600, file.path)
    ASC_KEY_TEMPFILES << file
    File.expand_path(file.path)
  else
    File.expand_path(path)
  end
end

# gym has no native -allowProvisioningUpdates and no ASC-key plumbing to
# xcodebuild (R1 V18), so the flags are threaded through BOTH `xcargs:`
# (build phase) and `export_xcargs:` (export phase). With `match`, profiles
# are already on disk and cloud updates are exactly what we do not want.
private_lane :signing_xcargs do
  if !ENV["MATCH_GIT_URL"].to_s.empty?
    ""
  elsif ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s.empty?
    UI.important("No ASC key — building without -allowProvisioningUpdates.")
    ""
  else
    [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{asc_key_file.shellescape}",
      "-authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_ID').shellescape}",
      "-authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_API_ISSUER').shellescape}",
    ].join(" ")
  end
end

private_lane :prepare_signing do
  # match needs a throwaway keychain on CI; setup_ci is the native answer and
  # also forces match into readonly (R1 V20a). Hand-rolling
  # `security create-keychain` is the anti-pattern it replaces.
  setup_ci if is_ci && !ENV["MATCH_GIT_URL"].to_s.empty?
end

# gym regenerates the export-options plist on every run and unconditionally
# overwrites `method`. The committed ExportOptions.plist exists for the
# non-fastlane `xcodebuild -exportArchive` fallback, so the two must not
# drift — assert instead of hoping.
private_lane :assert_export_options do |options|
  plist = repo_path(EXPORT_OPTIONS)
  UI.user_error!("#{EXPORT_OPTIONS} is missing.") unless File.exist?(plist)
  xml = File.read(plist)
  found = xml[%r{<key>method</key>\s*<string>([^<]+)</string>}, 1]
  want = options[:method]
  if found != want
    UI.user_error!("#{EXPORT_OPTIONS} declares method '#{found}' but this lane exports " \
                   "'#{want}'. gym overwrites the key at runtime, so the committed file " \
                   "would silently lie to the manual xcodebuild path. Fix the plist.")
  end
  team = xml[%r{<key>teamID</key>\s*<string>([^<]+)</string>}, 1]
  UI.important("#{EXPORT_OPTIONS} teamID=#{team} differs from #{TEAM_ID}") if team != TEAM_ID
end

platform :ios do
  desc "Sync signing certificates + profiles with match (opt-in)."
  desc "Options: readonly:false to create/renew (default: readonly on CI)."
  lane :certs do |options|
    if ENV["MATCH_GIT_URL"].to_s.empty?
      UI.user_error!("MATCH_GIT_URL is unset — this repo is on automatic/cloud signing " \
                     "(ops.signing: automatic). Nothing for `certs` to do. To switch, see " \
                     "docs/release-automation.md §Signing and fill in fastlane/Matchfile.")
    end
    require_macos
    prepare_signing

    ids = [APP_ID] + live_components.flat_map { |component| component[:ids] }
    readonly = options[:readonly].nil? ? is_ci : options[:readonly]

    match(type: "appstore", app_identifier: ids, readonly: readonly)
    # Developer ID certificates are not cloud-managed, so the notarised-Mac
    # path is the one that genuinely needs match (R1 V20/V24).
    next unless mac_enabled

    match(
      type: "developer_id",
      app_identifier: [APP_ID],
      additional_cert_types: ["developer_id_installer"],
      readonly: readonly,
    )
  end
end
