# .env.example — every environment variable this repo reads. COMMITTED.
#
# Copy to `.env` (gitignored) and fill in real values: `make env` does that
# and diffs the two when `.env` already exists. `.gitignore` blocks `.env`
# and `.env.*` while re-including this file.
#
# NEVER put a real secret in this file. One line, once, is leaked forever.
#
# HOW SECRETS ACTUALLY REACH A LANE
# Values here are `op://` references, not secrets. 1Password resolves them at
# exec time and nothing lands on disk:
#
#     op run --env-file=.env -- bundle exec fastlane beta
#     op run --env-file=.env -- make testflight
#
# In CI these same names are repository secrets — see
# .github/workflows/release.yml.
#
# NOTE: fastlane also natively loads `fastlane/.env*` (dotenv). This repo does
# not use that path — `.claude/settings.json` denies agent reads of it, and
# the root `.env` above is the single documented mechanism.

# --------------------------------------------------------------------------
# App Store Connect API key (ADR-0002, docs/asc-setup.md §2)
# --------------------------------------------------------------------------
# Must be a TEAM key with the App Manager or Admin role. Individual keys
# cannot use the provisioning endpoints or notarytool, which breaks
# bootstrap_asc, certs and notarize.

# The .p8 private key, base64-encoded. This is the CI-friendly form and the
# default. Generate with:  base64 -i AuthKey_ABC1234567.p8 | tr -d '\n'
APP_STORE_CONNECT_API_KEY=op://agentic/asc-api-key/base64_p8

# ...OR the path to a .p8 on disk. Convenient locally, useless on an
# ephemeral runner. Set EXACTLY ONE of these two — the Fastfile errors on
# both-or-neither. Keep the file outside the repo; *.p8 is gitignored anyway.
# APP_STORE_CONNECT_API_KEY_P8_PATH=~/.appstoreconnect/AuthKey_ABC1234567.p8

# The 10-character Key ID shown next to the key in App Store Connect.
APP_STORE_CONNECT_API_KEY_ID=op://agentic/asc-api-key/key_id

# The issuer UUID, shown once above the key list (same for every key on the
# team).
APP_STORE_CONNECT_API_ISSUER=op://agentic/asc-api-key/issuer_id

# Set to 1 once you have created group.com.example.myapp in the developer
# portal and attached it to every bundle ID (docs/asc-setup.md §4). Apple
# exposes no App Group endpoint, so bootstrap_asc cannot verify this itself
# and stops until you acknowledge it.
# ASC_APP_GROUP_VERIFIED=1

# --------------------------------------------------------------------------
# Code signing — only when ops.signing is `match`
# --------------------------------------------------------------------------
# Default is automatic/cloud signing, which needs none of this. The `certs`
# lane refuses to run until MATCH_GIT_URL is set. See
# docs/release-automation.md §6 and fastlane/Matchfile.
#
# MATCH_GIT_URL=git@github.com:you/certificates.git
# MATCH_PASSWORD=op://agentic/match/passphrase

# --------------------------------------------------------------------------
# Notifications (agentic-skeleton contract) — https://pushover.net/api
# --------------------------------------------------------------------------
# Optional. Release CI notifies on failure only when both are present.
PUSHOVER_APP_TOKEN=op://agentic/pushover/app_token
PUSHOVER_USER_KEY=op://agentic/pushover/user_key

# --------------------------------------------------------------------------
# Lane switches (not secrets)
# --------------------------------------------------------------------------
# Add device frames to screenshots. Off by default: frameit needs ImageMagick
# and community frame assets that lag new hardware. Equivalent to
# `ops.frameit: true` at onboarding, or `bundle exec fastlane screenshots
# frame:true` for one run.
# FRAMEIT=1

# DO NOT SET PILOT_DISTRIBUTE_EXTERNAL HERE — or anywhere.
# fastlane gives that one environment variable to two different pilot options
# (`distribute_external`, default false, and `submit_beta_review`, default
# true), so setting it silently changes a behaviour you did not intend. The
# `beta` lane passes both explicitly for exactly this reason; use
# `fastlane beta external:true groups:'…'` instead.

# --------------------------------------------------------------------------
# MCP
# --------------------------------------------------------------------------
# MCP servers take no credentials from this file.
# github + context7 resolve theirs at connect time from 1Password
# (scripts/mcp/op-headers.sh) and degrade to OAuth / anonymous tier without it.
